<?xml version="1.0" ?>
<!--
  contact_classification_test.world
  Test environment for the HaptiQuad tactile navigation framework.

  Layout (robot starts at origin, facing +X):
    x=2.0  cube_light_1   30 kg  GREEN  → expected: MOVABLE (robot pushes through)
    x=3.5  cube_heavy_1  200 kg  RED    → expected: SOLID   (robot replans)
    x=5.0  cube_light_2   30 kg  GREEN  → expected: MOVABLE (robot pushes through)
    x=6.5  cube_heavy_2  200 kg  RED    → expected: SOLID   (robot replans)
    x=8.0  cube_heavy_3  200 kg  RED    → expected: SOLID   (robot replans)

  Cube dimensions: 0.5 m × 0.5 m × 1.0 m (tall enough to enter the lidar
  height filter window: 0.05–0.8 m above base_link ≈ 0.64–1.39 m AGL).

  Light cubes: 30 kg, μ=0.1 → ground friction ≈ 29 N (above the 15 N fx
  threshold so contact is detected) but ANYmal can push them at probe speed.
  5 kg was too light: only ~5 N friction, below detection threshold entirely.
  Heavy cubes use μ=0.8; 200 kg × 9.81 × 0.8 ≈ 1570 N of static
  friction — the robot cannot push them.

  Navigation goal to send after launching:
    x=10.0, y=0.0 (in map frame)
-->
<sdf version="1.6">
  <world name="contact_classification_test">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── LIGHT CUBE 1 — x=2.0, 30 kg, GREEN ─────────────────────────── -->
    <!-- Mass raised from 5→30 kg: 5 kg at mu=0.1 produces only ~5 N friction,
         below the 15 N fx threshold. 30 kg gives ~29 N — detectable and still
         pushable by ANYmal at probe speed. -->
    <model name="cube_light_1">
      <pose>2.0 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>30.0</mass>
          <!-- Solid box 0.5×0.5×1.0 m: Ixx=Iyy=m/12*(0.25+1.0), Izz=m/12*(0.25+0.25) -->
          <inertia>
            <ixx>3.125</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>3.125</iyy>
            <iyz>0</iyz>
            <izz>1.25</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── HEAVY CUBE 1 — x=3.5, 200 kg, RED ─────────────────────────── -->
    <model name="cube_heavy_1">
      <pose>3.5 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <inertia>
            <ixx>20.8333</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>20.8333</iyy>
            <iyz>0</iyz>
            <izz>8.3333</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── LIGHT CUBE 2 — x=5.0, 30 kg, GREEN ─────────────────────────── -->
    <model name="cube_light_2">
      <pose>5.0 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>30.0</mass>
          <inertia>
            <ixx>3.125</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>3.125</iyy>
            <iyz>0</iyz>
            <izz>1.25</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── HEAVY CUBE 2 — x=6.5, 200 kg, RED ─────────────────────────── -->
    <model name="cube_heavy_2">
      <pose>6.5 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <inertia>
            <ixx>20.8333</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>20.8333</iyy>
            <iyz>0</iyz>
            <izz>8.3333</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── HEAVY CUBE 3 — x=8.0, 200 kg, RED ─────────────────────────── -->
    <model name="cube_heavy_3">
      <pose>8.0 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <inertia>
            <ixx>20.8333</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>20.8333</iyy>
            <iyz>0</iyz>
            <izz>8.3333</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 1.0</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Scene settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Initial camera — looking along +X from the side -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>5 -8 3 0 0.3 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
