<?xml version="1.0" ?>
<!--
  mixed_obstacles_test.world
  HaptiQuad tactile navigation — varied object layout.

  Robot starts at origin facing +X.  Send goal to (14.0, 0.0) in map frame.

  Color convention: Red = SOLID (heavy, high friction, robot replans)
                   Green = MOVABLE (light, low friction, robot pushes through)

  Object summary:
    x=2.5   box_solid_A      0.6×0.6×1.0 m   200 kg  μ=0.8  y=+0.4   Red    SOLID
    x=3.5   cyl_movable_A    r=0.25 h=1.0 m    5 kg  μ=0.05 y=-0.7   Green  MOVABLE
    x=5.0   box_solid_B      0.8×0.4×1.0 m   200 kg  μ=0.8  y=+0.2   Red    SOLID
    x=6.5   cyl_solid_A      r=0.30 h=1.2 m  200 kg  μ=0.8  y=-0.6   Red    SOLID
    x=7.5   box_movable_A    0.5×0.5×1.0 m     5 kg  μ=0.05 y=+0.5   Green  MOVABLE
    x=8.5   cyl_movable_B    r=0.20 h=1.0 m    5 kg  μ=0.05 y=-0.2   Green  MOVABLE
    x=10.0  box_solid_C      0.5×0.8×1.0 m   200 kg  μ=0.8  y=+0.3   Red    SOLID
    x=11.5  cyl_solid_B      r=0.25 h=1.0 m  200 kg  μ=0.8  y=-0.8   Red    SOLID
    x=12.0  box_movable_B    0.4×0.4×1.0 m     5 kg  μ=0.05 y=+0.9   Green  MOVABLE
-->
<sdf version="1.6">
  <world name="mixed_obstacles_test">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1</mu><mu2>1</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── SOLID BOX A — 0.6×0.6×1.0 m, 200 kg, x=2.5 y=+0.4 ─────── -->
    <model name="box_solid_A">
      <pose>2.5 0.4 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <!-- Ixx=Iyy=200/12*(0.36+1.0)=22.667  Izz=200/12*(0.36+0.36)=12.0 -->
          <inertia>
            <ixx>22.667</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>22.667</iyy><iyz>0</iyz>
            <izz>12.0</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── MOVABLE CYLINDER A — r=0.25 h=1.0 m, 5 kg, x=3.5 y=-0.7 ── -->
    <model name="cyl_movable_A">
      <pose>3.5 -0.7 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <!-- Ixx=Iyy=5*(3*0.0625+1.0)/12=0.495  Izz=5*0.0625/2=0.156 -->
          <inertia>
            <ixx>0.495</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.495</iyy><iyz>0</iyz>
            <izz>0.156</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── SOLID BOX B — 0.8×0.4×1.0 m, 200 kg, x=5.0 y=+0.2 ──────── -->
    <model name="box_solid_B">
      <pose>5.0 0.2 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <!-- Ixx=200/12*(0.16+1.0)=19.333  Iyy=200/12*(0.64+1.0)=27.333  Izz=200/12*0.80=13.333 -->
          <inertia>
            <ixx>19.333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>27.333</iyy><iyz>0</iyz>
            <izz>13.333</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.8 0.4 1.0</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── SOLID CYLINDER A — r=0.30 h=1.2 m, 200 kg, x=6.5 y=-0.6 ── -->
    <model name="cyl_solid_A">
      <pose>6.5 -0.6 0.6 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <!-- Ixx=Iyy=200*(3*0.09+1.44)/12=28.5  Izz=200*0.09/2=9.0 -->
          <inertia>
            <ixx>28.5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>28.5</iyy><iyz>0</iyz>
            <izz>9.0</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── MOVABLE BOX A — 0.5×0.5×1.0 m, 5 kg, x=7.5 y=+0.5 ──────── -->
    <model name="box_movable_A">
      <pose>7.5 0.5 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <!-- Ixx=Iyy=5/12*(0.25+1.0)=0.521  Izz=5/12*(0.25+0.25)=0.208 -->
          <inertia>
            <ixx>0.521</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.521</iyy><iyz>0</iyz>
            <izz>0.208</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <surface>
            <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── MOVABLE CYLINDER B — r=0.20 h=1.0 m, 5 kg, x=8.5 y=-0.2 ── -->
    <model name="cyl_movable_B">
      <pose>8.5 -0.2 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <!-- Ixx=Iyy=5*(3*0.04+1.0)/12=0.467  Izz=5*0.04/2=0.1 -->
          <inertia>
            <ixx>0.467</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.467</iyy><iyz>0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── SOLID BOX C — 0.5×0.8×1.0 m, 200 kg, x=10.0 y=+0.3 ──────── -->
    <model name="box_solid_C">
      <pose>10.0 0.3 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <!-- Ixx=200/12*(0.64+1.0)=27.333  Iyy=200/12*(0.25+1.0)=20.833  Izz=200/12*0.89=14.833 -->
          <inertia>
            <ixx>27.333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>20.833</iyy><iyz>0</iyz>
            <izz>14.833</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.5 0.8 1.0</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.8 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── SOLID CYLINDER B — r=0.25 h=1.0 m, 200 kg, x=11.5 y=-0.8 ─ -->
    <model name="cyl_solid_B">
      <pose>11.5 -0.8 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>200.0</mass>
          <!-- Ixx=Iyy=200*(3*0.0625+1.0)/12=19.792  Izz=200*0.0625/2=6.25 -->
          <inertia>
            <ixx>19.792</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>19.792</iyy><iyz>0</iyz>
            <izz>6.25</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── MOVABLE BOX B — 0.4×0.4×1.0 m, 5 kg, x=12.0 y=+0.9 ──────── -->
    <model name="box_movable_B">
      <pose>12.0 0.9 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5.0</mass>
          <!-- Ixx=Iyy=5/12*(0.16+1.0)=0.483  Izz=5/12*(0.16+0.16)=0.133 -->
          <inertia>
            <ixx>0.483</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.483</iyy><iyz>0</iyz>
            <izz>0.133</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <surface>
            <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Camera — bird's eye view tilted along +X -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>7 -10 4 0 0.35 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
